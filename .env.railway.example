# =============================================================================
# Railway fullstack variables — Government Revenue Platform
# Repo: statisense/revenue-backend
#
# Create these Railway services (exact names used in ${{...}} below):
#   revenue-backend   → Config-as-code: /apps/api/railway.toml
#   revenue-web       → Config-as-code: /apps/web/railway.toml
#   MySQL             → Railway MySQL plugin
#   Redis             → Railway Redis plugin
#   RabbitMQ          → Docker image rabbitmq:3-management-alpine
#                       + RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS
#
# If a service has a different name, rename the ${{ServiceName.*}} parts.
# Do NOT wrap values in quotes in the Railway UI.
# Do NOT use localhost / 127.0.0.1 / port 3316.
# =============================================================================

# ─── revenue-backend (API) ───────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api/v1
API_URL=auto
PORT=4000
TENANT_AGENCY_CODE=NCS
COOKIE_SECURE=true
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
DEFAULT_CURRENCY=NGN

DATABASE_URL=${{MySQL.MYSQL_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

RABBITMQ_URL=amqp://revenue:${{RabbitMQ.RABBITMQ_DEFAULT_PASS}}@${{RabbitMQ.RAILWAY_PRIVATE_DOMAIN}}:5672
RABBITMQ_USER=revenue
RABBITMQ_PASS=${{RabbitMQ.RABBITMQ_DEFAULT_PASS}}
RABBITMQ_HOST=${{RabbitMQ.RAILWAY_PRIVATE_DOMAIN}}

# Point at the Web service public URL (admin + /pay)
APP_URL=https://${{revenue-web.RAILWAY_PUBLIC_DOMAIN}}
PAY_URL=https://${{revenue-web.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{revenue-web.RAILWAY_PUBLIC_DOMAIN}}

# Secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
HMAC_PAYMENT_SECRET=
FIELD_ENCRYPTION_KEY=

PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# First deploy only — seeds NCS demo users, then set back to false
SEED_ON_BOOT=false

# ─── revenue-web (Next.js admin + pay portal) ────────────────────────────────
# Build-time vars (redeploy Web after changing NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=https://${{revenue-backend.RAILWAY_PUBLIC_DOMAIN}}/api/v1
NEXT_PUBLIC_AUTO_LOGIN=false
PORT=3000

# ─── RabbitMQ service ────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=revenue
RABBITMQ_DEFAULT_PASS=
